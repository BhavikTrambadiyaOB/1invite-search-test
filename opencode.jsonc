{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".ai/rules/index.md"],
  "mcp": {
    "servers": {
      "next-devtools": {
        "type": "local",
        "command": ["npx", "-y", "next-devtools-mcp@latest"],
        "cwd": "."
      },
      "shadcn": {
        "type": "local",
        "command": ["npx", "-y", "shadcn@latest", "mcp"],
        "cwd": "."
      },
      "mastra-docs": {
        "type": "local",
        "command": ["npx", "-y", "@mastra/mcp-docs-server@latest"],
        "cwd": ".",
        "timeout": {
          "startup": 60000
        }
      }
    }
  }
}
