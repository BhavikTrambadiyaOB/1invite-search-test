OPENAI_API_KEY=your-api-key

# PostgreSQL connection used by Next.js and Mastra.
# Local setup: postgresql://USER:PASSWORD@127.0.0.1:5432/invite_template_search
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/invite_template_search

# Set to true for hosted providers that require SSL (e.g. Neon, Supabase).
DATABASE_SSL=false

# Template previews: CDN base URL joined with images.image.
CDN_URL=https://your-cdn.example.com/path

# Template search AI. Search works without AI; set both to turn it on.
SEARCH_AI_ENABLED=false
# Optional model overrides (Mastra "provider/model" ids).
# SEARCH_AI_ENRICH_MODEL=openai/gpt-6-luna
# SEARCH_AI_QUERY_MODEL=openai/gpt-6-luna
# SEARCH_AI_EMBEDDING_MODEL=openai/text-embedding-3-large

# Optional: connection for the read-only MCP server (scripts/mcp/db-readonly.ts).
# Best practice: a role with SELECT rights only. Falls back to DATABASE_URL.
# MCP_DATABASE_URL=postgresql://readonly_user:password@127.0.0.1:5432/invite_template_search

# Side-by-side search report (/search/report): live production search snapshot.
# Use the same values as the production request. LIVE_SEARCH_TOKEN is the Bearer token.
LIVE_SEARCH_URL=https://mapi.1invites.com/api/public/api/searchCardsByMultipleSubCategoryId
LIVE_SUGGESTED_EXTENSIONS_URL=https://mapi.1invites.com/api/public/api/getSuggestedExtensionsFromUserInput
LIVE_SEARCH_TOKEN=
LIVE_SEARCH_SUB_CATEGORY_ID=169
LIVE_SEARCH_PLATFORM=2
LIVE_SEARCH_COUNTRY_CODE=in
