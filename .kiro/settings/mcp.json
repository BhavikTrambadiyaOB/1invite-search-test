{
  "mcpServers": {
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"],
      "cwd": ".",
      "disabled": false,
      "autoApprove": []
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"],
      "cwd": ".",
      "disabled": false,
      "autoApprove": []
    },
    "mastra-docs": {
      "command": "npx",
      "args": ["-y", "@mastra/mcp-docs-server@latest"],
      "cwd": ".",
      "disabled": false,
      "autoApprove": []
    }
  }
}
