# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# mastra local storage
mastra.db*
mastra.duckdb*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.idea
.claude/*
!.claude/settings.json
!.claude/skills/

.mastra

# search regression snapshots
search-snapshots/

# per-machine marker for "nothing to record" (decision log)
.ai/decisions/.last-review
